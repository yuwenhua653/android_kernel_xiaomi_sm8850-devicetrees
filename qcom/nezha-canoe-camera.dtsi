&qupv3_se8_i2c {
	dmas = <&gpi_dma2 0 0 3 1024 0>,
		<&gpi_dma2 1 0 3 1024 0>;
	pinctrl-1 = <&nezha_qupv3_se8_i2c_sleep>;
	pinctrl-0 = <&nezha_qupv3_se8_i2c_sda_active>,
		<&nezha_qupv3_se8_i2c_scl_active>;
	qcom,pm-ctrl-client;
	qcom,clk-freq-out = <1000000>;
	qcom,high-perf;
	status = "ok";
	eeprom_ultra: qcom,eeprom2 {
		status = "ok";
		rgltr-load-current = <3000>;
		rgltr-max-voltage = <1800000>;
		rgltr-min-voltage = <1800000>;
		rgltr-cntrl-support;
		regulator-names = "cam_vio";
		cam_vio-supply = <&L5M>;
		compatible = "qcom,cam-i2c-eeprom";
		reg = <80>;
		cell-index = <2>;
	};
	actuator_ultra: qcom,actuator2 {
		status = "ok";
		rgltr-load-current = <2000000 103000 3000>;
		rgltr-max-voltage = <3296000 3200000 1800000>;
		rgltr-min-voltage = <3296000 3200000 1800000>;
		rgltr-cntrl-support;
		regulator-names = "cam_bob2", "cam_vaf", "cam_vio";
		cam_vio-supply = <&L5M>;
		cam_vaf-supply = <&L3M>;
		cam_bob2-supply = <&BOB2>;
		compatible = "qcom,cam-i2c-actuator";
		reg = <9>;
		cell-index = <2>;
	};
	qcom,cam-sensor2 {
		status = "ok";
		clock-rates = <19200000>;
		clock-cntl-level = "nominal";
		clock-names = "cam_clk";
		clocks = <&cambistmclkcc 10>;
		gpio-req-tbl-label = "CAMIF_MCLK4", "CAM_RESET4";
		gpio-req-tbl-flags = <1 0>;
		gpio-req-tbl-num = <0 1>;
		gpio-reset = <1>;
		gpios = <&tlmm 93 0>,
			<&tlmm 7 0>;
		pinctrl-1 = <&cam_sensor_mclk4_suspend>,
			<&cam_sensor_suspend_rst4>;
		pinctrl-0 = <&cam_sensor_mclk4_active>,
			<&cam_sensor_active_rst4>;
		pinctrl-names = "cam_default", "cam_suspend";
		gpio-no-mux = <0>;
		rgltr-load-current = <103000 522730 150000 103000 150000 2000000>;
		rgltr-max-voltage = <1800000 1000000 2200000 3200000 1800000 3296000>;
		rgltr-min-voltage = <1800000 1000000 2200000 3200000 1800000 3296000>;
		aon-camera-id = <0>;
		rgltr-cntrl-support;
		regulator-names = "cam_vio", "cam_vdig", "cam_vana", "cam_vaf", "cam_v_custom2", "cam_bob2";
		power-domains = <&camcc 5>;
		cam_bob2-supply = <&BOB2>;
		cam_v_custom2-supply = <&L6M>;
		cam_vaf-supply = <&L3M>;
		cam_vana-supply = <&L4M>;
		cam_vdig-supply = <&L2M>;
		cam_vio-supply = <&L5M>;
		sensor-position-yaw = <180>;
		sensor-position-pitch = <0>;
		sensor-position-roll = <90>;
		eeprom-src = <&eeprom_ultra>;
		actuator-src = <&actuator_ultra>;
		led-flash-src = <&led_flash_rear_ultra>;
		csiphy-sd-index = <4>;
		compatible = "qcom,cam-i2c-sensor";
		reg = <54>;
		cell-index = <2>;
	};
};

&qupv3_se9_i2c {
	pinctrl-1 = <&nezha_qupv3_se9_i2c_sleep>;
	pinctrl-0 = <&nezha_qupv3_se9_i2c_sda_active>,
		<&nezha_qupv3_se9_i2c_scl_active>;
	qcom,pm-ctrl-client;
	qcom,clk-freq-out = <1000000>;
	qcom,high-perf;
	status = "ok";
	actuator_front: qcom,actuator1 {
		rgltr-load-current = <103000 3000>;
		rgltr-max-voltage = <2840000 1800000>;
		rgltr-min-voltage = <2840000 1800000>;
		rgltr-cntrl-support;
		regulator-names = "cam_vaf", "cam_vio";
		cam_vio-supply = <&L5M>;
		cam_vaf-supply = <&L4N>;
		compatible = "qcom,cam-i2c-actuator";
		reg = <9>;
		cell-index = <1>;
	};
	eeprom_front: qcom,eeprom1 {
		status = "ok";
		rgltr-load-current = <3000>;
		rgltr-max-voltage = <1800000>;
		rgltr-min-voltage = <1800000>;
		rgltr-cntrl-support;
		regulator-names = "cam_vio";
		cam_vio-supply = <&L5M>;
		compatible = "qcom,cam-i2c-eeprom";
		reg = <81>;
		cell-index = <1>;
	};
	qcom,cam-sensor1 {
		status = "ok";
		clock-rates = <19200000>;
		clock-cntl-level = "nominal";
		clock-names = "cam_clk";
		clocks = <&cambistmclkcc 6>;
		gpio-req-tbl-label = "CAMIF_MCLK2", "CAM_RESET2";
		gpio-req-tbl-flags = <1 0>;
		gpio-req-tbl-num = <0 1>;
		gpio-reset = <1>;
		gpios = <&tlmm 91 0>,
			<&tlmm 3 0>;
		pinctrl-1 = <&cam_sensor_front_mclk2_suspend>,
			<&cam_sensor_front_reset2_suspend>;
		pinctrl-0 = <&cam_sensor_front_mclk2_active>,
			<&cam_sensor_front_reset2_active>;
		pinctrl-names = "cam_default", "cam_suspend";
		gpio-no-mux = <0>;
		rgltr-load-current = <3000 283000 50000 103000 2000000 2000000>;
		rgltr-max-voltage = <1800000 1160000 2840000 2840000 3400000 3296000>;
		rgltr-min-voltage = <1800000 1160000 2840000 2840000 3400000 3296000>;
		regulator-names = "cam_vio", "cam_vdig", "cam_vana", "cam_vaf", "cam_bob", "cam_bob2";
		aon-camera-id = <1>;
		rgltr-cntrl-support;
		power-domains = <&camcc 5>;
		cam_bob2-supply = <&BOB2>;
		cam_bob-supply = <&BOB1>;
		cam_vaf-supply = <&L4N>;
		cam_vana-supply = <&L6N>;
		cam_vdig-supply = <&L1N>;
		cam_vio-supply = <&L5M>;
		sensor-position-yaw = <0>;
		sensor-position-pitch = <0>;
		sensor-position-roll = <270>;
		csiphy-sd-index = <2>;
		eeprom-src = <&eeprom_front>;
		actuator-src = <&actuator_front>;
		compatible = "qcom,cam-i2c-sensor";
		reg = <16>;
		cell-index = <1>;
	};
};

&pmh0101_flash {
	compatible = "qcom,pmh0101-flash-led", "qcom,spmi-flash-led";
	reg = <60928>;
	led-0 {
		function = "flash";
		function-enumerator = <0>;
		color = <6>;
		led-sources = <1 4>;
		led-max-microamp = <500000>;
		flash-max-microamp = <1200000>;
		flash-max-timeout-us = <300000>;
	};
	led-1 {
		function = "flash";
		function-enumerator = <1>;
		color = <0>;
		led-sources = <2 3>;
		led-max-microamp = <500000>;
		flash-max-microamp = <2000000>;
		flash-max-timeout-us = <1280000>;
	};
	led-2 {
		function = "flash";
		function-enumerator = <2>;
		color = <4>;
		led-sources = <1 2 3 4>;
		led-max-microamp = <500000>;
		flash-max-microamp = <2000000>;
		flash-max-timeout-us = <1280000>;
	};
};
