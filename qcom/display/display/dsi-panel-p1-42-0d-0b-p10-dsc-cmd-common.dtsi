/* Xiaomi 17 Ultra panel configuration, OS4.0.7.0.XPACNXM. */
qcom,mdss-dsi-on-command-state = "dsi_lp_mode";
mi,mdss-dsi-timing-switch-pwm-command-state = "dsi_hs_mode";
qcom,mdss-dsi-timing-switch-command-state = "dsi_hs_mode";
qcom,mdss-dsi-nolp-command-update = <81 0 2>;
qcom,mdss-dsi-nolp-command-state = "dsi_hs_mode";
qcom,mdss-dsi-nolp-command = [39 00 00 00 00 00 03 51 00 23];
qcom,partial-update-enabled = "single_roi";
qcom,panel-roi-alignment = <1200 16 1200 16 1200 16>;
qcom,mdss-dsc-block-prediction-enable;
qcom,mdss-dsc-bit-per-pixel = <8>;
qcom,mdss-dsc-bit-per-component = <10>;
qcom,mdss-dsc-slice-per-pkt = <2>;
qcom,mdss-dsc-slice-width = <600>;
qcom,mdss-dsc-slice-height = <16>;
qcom,mdss-dsc-scr-version = <0>;
qcom,mdss-dsc-version = <18>;
qcom,compression-mode = "dsc";
qcom,default-topology-index = <0>;
qcom,display-topology = <2 2 1>;
qcom,mdss-dsi-panel-phy-timings = [00 27 0a 0a 1b 19 0a 0b 0a 02 04 00 20 0f];
qcom,mdss-mdp-transfer-time-us = <7300>;
qcom,mdss-dsi-panel-jitter = <5 1>;
qcom,mdss-dsi-panel-clockrate = <0x47680780>;
qcom,mdss-dsi-v-bottom-border = <0>;
qcom,mdss-dsi-v-top-border = <0>;
qcom,mdss-dsi-h-right-border = <0>;
qcom,mdss-dsi-h-left-border = <0>;
qcom,mdss-dsi-h-sync-pulse = <0>;
qcom,mdss-dsi-v-pulse-width = <32>;
qcom,mdss-dsi-v-front-porch = <64>;
qcom,mdss-dsi-v-back-porch = <64>;
qcom,mdss-dsi-h-pulse-width = <32>;
qcom,mdss-dsi-h-back-porch = <64>;
qcom,mdss-dsi-h-front-porch = <64>;
qcom,mdss-dsi-panel-height = <2608>;
qcom,mdss-dsi-panel-width = <1200>;
mi,mdss-dsi-round-corner-off-command-state = "dsi_lp_mode";
mi,mdss-dsi-round-corner-off-command = [
	39 00 00 40 00 00 03 f0 aa 18 39 00 00 00 00 00
	02 b0 00
];
mi,mdss-dsi-round-corner-on-command-state = "dsi_lp_mode";
mi,mdss-dsi-round-corner-on-command = [
	39 00 00 40 00 00 03 f0 aa 18 39 00 00 00 00 00
	02 b0 80
];
mi,mdss-dsi-doze-lbm-command-state = "dsi_hs_mode";
mi,mdss-dsi-doze-lbm-command = [39 00 00 00 00 00 03 51 00 2d];
mi,mdss-dsi-doze-hbm-command-state = "dsi_hs_mode";
mi,mdss-dsi-doze-hbm-command = [39 00 00 00 00 00 03 51 02 60];
mi,mdss-dsi-hbm-off-command-state = "dsi_hs_mode";
mi,mdss-dsi-hbm-off-command-update = <81 0 2>;
mi,mdss-dsi-hbm-off-command = [39 00 00 00 00 00 03 51 15 54];
mi,mdss-dsi-hbm-on-command-state = "dsi_hs_mode";
mi,mdss-dsi-hbm-on-command = [39 00 00 00 00 00 03 51 34 bc];
qcom,mdss-dsi-off-command-state = "dsi_hs_mode";
qcom,mdss-dsi-off-command = [
	39 00 00 40 00 00 03 51 00 00 05 00 00 00 1e 00
	01 28 05 00 00 00 78 00 01 10
];
mi,mdss-dsi-dc-off-command-state = "dsi_hs_mode";
mi,mdss-dsi-dc-off-command;
mi,mdss-dsi-dc-on-command-state = "dsi_hs_mode";
mi,mdss-dsi-dc-on-command;
