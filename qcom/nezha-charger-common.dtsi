&soc {
	mca_fg_psy: fuel-gauge-bridge {
		compatible = "xiaomi,nezha-fg-psy";
		power-supplies = <&nezha_fuel_gauge>;
		status = "okay";
	};

	mca_qcom_subpmic_proxy: mca_qcom_subpmic_proxy {
		compatible = "mca,qcom_subpmic";
		status = "okay";
	};

	mca_panel: mca_panel {
		compatible = "mca,mca_panel";
		status = "ok";
	};

	mca_bc12_class: mca_bc12_class {
		compatible = "mca,bc12_class";
		status = "ok";
	};

	mca_protocol_core: mca_protocol_core {
		compatible = "mca,protocol_core";
		status = "ok";
	};

	mca_protocol_pd_class: mca_protocol_pd_class {
		compatible = "mca,protocol_pd";
		status = "ok";
		support_mode = <4>;
		max_power = <90>;
	};

	mca_qcom_pd_protocol: mca_qcom_pd_protocol {
		compatible = "mca,adsp_pd_protocol";
		status = "ok";
	};

	mca_protocol_qc_class: mca_protocol_qc_class {
		compatible = "mca,protocol_qc";
		status = "ok";
	};

	mca_platform_cp: mca_platform_cp {
		compatible = "mca,platform_cp";
		status = "ok";
		cp-num = <1>;
		cp-dir-list = "cp_master";
	};

	mca_platform_loadsw: mca_platform_loadsw {
		compatible = "mca,platform_loadsw";
		status = "disabled";
		loadsw-num = <1>;
		loadsw-dir-list = "loadsw_master";
	};
};

&mca_adsp_glink {
	status = "ok";
};

&tlmm {
	charger_cp_nlpm_default: charger_cp_nlpm_default {
		mux {
			pins = "gpio114";
			function = "gpio";
		};

		config {
			pins = "gpio114";
			drive-strength = <2>;
			bias-disable;
		};
	};

	charger_cp_int_default: charger_cp_int_default {
		mux {
			pins = "gpio209";
			function = "gpio";
		};

		config {
			pins = "gpio209";
			drive-strength = <2>;
			bias-disable;
		};
	};
};

&qupv3_se5_i2c {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	nezha_fuel_gauge: fuel-gauge@55 {
		compatible = "ti,bq27z561";
		reg = <0x55>;
		label = "battery";
	};

	sc8585_master@6e {
		compatible = "sc8585_master";
		reg = <0x6e>;
		ic_role = <0>;
		cp-int = <&tlmm 209 0>;
		cp-nlpm-gpio = <&tlmm 114 0>;
		pinctrl-names = "default";
		pinctrl-0 = <&charger_cp_nlpm_default &charger_cp_int_default>;
		bat-ovp-threshold = <4700>;
		bat-ovp-alarm-threshold = <4650>;
		bus-ovp-threshold = <21000 12000 6000>;
		usb-ovp-threshold = <21000 14000 7500>;
		bus-ocp-threshold = <5000 5600 5000>;
		wpc-ovp-threshold = <21000>;
		out-ovp-threshold = <5000>;
		pmid2-uvp-threshold = <350 350 100>;
		pmid2-ovp-threshold = <600>;
	};
};
