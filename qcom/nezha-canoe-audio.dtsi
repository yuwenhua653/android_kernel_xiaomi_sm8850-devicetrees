				qcom,cdc-vdd-1p8-lpm-supported = <1>;
				qcom,cdc-vdd-1p8-current = <20000>;
				qcom,cdc-vdd-1p8-voltage = <1800000 1800000>;
				cdc-vdd-1p8-supply = <&L15B>;
				qcom,swr-wsa-port-params = <2 0 4 0 21 0 9 0>,
					<13 0 25 0 2 0 4 0>,
					<21 0 9 0 13 0 25 0>,
					<2 0 4 0 21 0 9 0>,
					<13 0 25 0 2 0 4 0>,
					<21 0 9 0 13 0 25 0>;
				qcom,wsa-macro-handle = <&wsa2_macro>;
				qcom,lpass-cdc-handle = <&lpass_cdc>;
				qcom,spkr-sd-n-node = <&wsa_spkr_en13>;
				reg = <4 35062305>;
				compatible = "qcom,wsa884x_2";
				status = "disabled";
			};
			swr_haptics: swr_haptics@f0170220 {
				qcom,rx_swr_vi_ch_map = <2 2 3 1200000 10>;
				qcom,rx_swr_ch_map = <0 1 1 0 9>;
				swr-slave-supply = <&hap_swr_slave_reg>;
				reg = <3 0xf0170220>;
				compatible = "qcom,pmih010x-swr-haptics";
				status = "ok";
			};
		};
	};
	va_macro: va-macro@7660000 {
		reg = <0x7660000 0>;
		qcom,va-swr-gpios = <&va_swr_gpios>;
		qcom,is-used-swr-gpio = <1>;
		qcom,use-clk-id = <3>;
		qcom,default-clk-id = <0>;
		qcom,va-clk-mux-select = <1>;
		qcom,va-dmic-override-clk-div-factor = <4 4 4 4>;
		qcom,va-dmic-clk-div-factor = <16 16 16 16>;
		clocks = <&lpass_audio_hw_vote 0>;
		clock-names = "lpass_audio_hw_vote";
		compatible = "qcom,lpass-cdc-va-macro";
		swr2: va_swr_master {
			qcom,swr-master-version = <33554432>;
			interrupts = <0 761 4 0 785 4>;
			swrm-io-base = <0x7630000 0>;
			qcom,is-always-on = <1>;
			qcom,swr-mstr-irq-wakeup-capable = <1>;
			qcom,swr-clock-stop-mode0 = <1>;
			qcom,swr-num-dev = <5>;
			qcom,swr-port-mapping = <1 45 3 2 46 1 2 47>,
				<2 2 48 4 2 49 8 3>,
				<50 1 3 51 2 3 52 4>,
				<3 53 8 4 54 1 4 55>,
				<2 4 56 4 4 57 8 5>,
				<58 3>;
			interrupt-names = "swr_master_irq", "swr_wake_irq";
			qcom,swr-num-ports = <5>;
			qcom,swr-wakeup-required = <1>;
			qcom,mipi-sdw-block-packing-mode = <1>;
			qcom,swr_master_id = <3>;
			clocks = <&lpass_core_hw_vote 0>,
				<&lpass_audio_hw_vote 0>;
			clock-names = "lpass_core_hw_vote", "lpass_audio_hw_vote";
			#size-cells = <0>;
			#address-cells = <2>;
			compatible = "qcom,swr-mstr";
			wcd939x_tx_slave: wcd939x-tx-slave {
				reg = <14 18285091>;
				compatible = "qcom,wcd939x-slave";
			};
			wcd9378_tx_slave: wcd9378-tx-slave {
				reg = <16 18285091>;
