/* Nezha OS4.0.7.0.XPACNXM Canoe audio and haptic wiring. */
#include "audio/canoe-audio.dtsi"
#include "audio/canoe-lpi.dtsi"

&spmi0_bus {
	pmk8850@0 {
		pmk8850_sdam_46: sdam@9d00 {
			compatible = "qcom,spmi-sdam";
			reg = <40192>;
		};
	};
};

&spmi1_bus {
	qcom,pmih010x@7 {
		compatible = "qcom,spmi-pmic";
		reg = <7 0>;
		#address-cells = <1>;
		#size-cells = <0>;
		pmih010x_haptics: qcom,hv-haptics@f000 {
			qcom,lra-f0-cal-count = <570>;
			qcom,lra-f0-default = <170>;
			qcom,lra-f0-max = <180>;
			qcom,lra-f0-min = <160>;
			qcom,f0-vmax-mv = <2100>;
			qcom,custom_vmax_mv = <8500>;
			qcom,rev_t_lra_us = <70>;
			qcom,brake-disable;
			status = "ok";
			compatible = "qcom,hv-haptics";
			reg = <61440 61696 61952>;
			interrupts = <7 240 1 1>;
			interrupt-names = "fifo-empty";
			qcom,vmax-mv = <2000>;
			qcom,lra-period-us = <5555>;
			qcom,brake-mode = <1>;
			qcom,brake-pattern = [
				00
			];
			qcom,drv-sig-shape = <1>;
			qcom,brake-sig-shape = <1>;
			qcom,rt-imp-detect;
			nvmem-names = "hap_cfg_sdam";
			nvmem = <&pmk8850_sdam_46>;
			hap_swr_slave_reg: qcom,hap-swr-slave-reg {
				regulator-name = "hap-swr-slave-reg";
			};
			effect_0 {
				qcom,effect-id = <0>;
				qcom,wf-vmax-mv = <3600>;
				qcom,wf-fifo-preload;
				qcom,wf-fifo-data = <0x7f7f7f7f>;
				qcom,wf-fifo-period = <0>;
				qcom,wf-auto-res-disable;
				qcom,wf-brake-disable;
			};
			effect_1 {
				qcom,effect-id = <1>;
				qcom,wf-vmax-mv = <3600>;
				qcom,wf-fifo-preload;
				qcom,wf-fifo-data = [
					7f 7f 7f 7f 7f 7f
				];
				qcom,wf-fifo-period = <0>;
				qcom,wf-auto-res-disable;
				qcom,wf-brake-disable;
			};
			effect_2 {
				qcom,effect-id = <2>;
				qcom,wf-vmax-mv = <3600>;
				qcom,wf-fifo-preload;
				qcom,wf-fifo-data = [
					7f 7f
				];
				qcom,wf-fifo-period = <0>;
				qcom,wf-auto-res-disable;
				qcom,wf-brake-disable;
			};
			effect_3 {
				qcom,effect-id = <3>;
				qcom,wf-vmax-mv = <3600>;
				qcom,wf-fifo-preload;
				qcom,wf-fifo-data = [
					7f 7f 7f
				];
				qcom,wf-fifo-period = <0>;
				qcom,wf-auto-res-disable;
				qcom,wf-brake-disable;
			};
			effect_4 {
				qcom,effect-id = <4>;
				qcom,wf-vmax-mv = <3600>;
				qcom,wf-fifo-preload;
				qcom,wf-fifo-data = [
					7f 7f 7f
				];
				qcom,wf-fifo-period = <0>;
				qcom,wf-auto-res-disable;
				qcom,wf-brake-disable;
			};
			effect_5 {
				qcom,effect-id = <5>;
				qcom,wf-vmax-mv = <3600>;
				qcom,wf-fifo-preload;
				qcom,wf-fifo-data = [
					7f 7f 7f 7f 7f 7f
				];
				qcom,wf-fifo-period = <0>;
				qcom,wf-auto-res-disable;
				qcom,wf-brake-disable;
			};
			primitive_0 {
				qcom,primitive-id = <0>;
				qcom,wf-vmax-mv = <3600>;
				qcom,wf-fifo-preload;
				qcom,wf-fifo-data = <0>;
				qcom,wf-fifo-period = <0>;
				qcom,wf-auto-res-disable;
				qcom,wf-brake-disable;
			};
			primitive_1 {
				qcom,primitive-id = <1>;
				qcom,wf-vmax-mv = <3600>;
				qcom,wf-fifo-preload;
				qcom,wf-fifo-data = [
					7f 7f
				];
				qcom,wf-fifo-period = <0>;
				qcom,wf-auto-res-disable;
				qcom,wf-brake-disable;
			};
			primitive_2 {
				qcom,primitive-id = <2>;
				qcom,wf-vmax-mv = <3600>;
				qcom,wf-fifo-preload;
				qcom,wf-fifo-data = [
					7f 7f
				];
				qcom,wf-fifo-period = <0>;
				qcom,wf-auto-res-disable;
				qcom,wf-brake-disable;
			};
			primitive_3 {
				qcom,primitive-id = <3>;
				qcom,wf-vmax-mv = <3600>;
				qcom,wf-fifo-preload;
				qcom,wf-fifo-data = [
					7f 7f
				];
				qcom,wf-fifo-period = <0>;
				qcom,wf-auto-res-disable;
				qcom,wf-brake-disable;
			};
			primitive_4 {
				qcom,primitive-id = <4>;
				qcom,wf-vmax-mv = <3600>;
				qcom,wf-fifo-preload;
				qcom,wf-fifo-data = [
					7f 7f
				];
				qcom,wf-fifo-period = <0>;
				qcom,wf-auto-res-disable;
				qcom,wf-brake-disable;
			};
			primitive_5 {
				qcom,primitive-id = <5>;
				qcom,wf-vmax-mv = <3600>;
				qcom,wf-fifo-preload;
				qcom,wf-fifo-data = [
					7f 7f
				];
				qcom,wf-fifo-period = <0>;
				qcom,wf-auto-res-disable;
				qcom,wf-brake-disable;
			};
			primitive_6 {
				qcom,primitive-id = <6>;
				qcom,wf-vmax-mv = <3600>;
				qcom,wf-fifo-preload;
				qcom,wf-fifo-data = [
					7f 7f
				];
				qcom,wf-fifo-period = <0>;
				qcom,wf-auto-res-disable;
				qcom,wf-brake-disable;
			};
			primitive_7 {
				qcom,primitive-id = <7>;
				qcom,wf-vmax-mv = <3600>;
				qcom,wf-fifo-preload;
				qcom,wf-fifo-data = [
					7f 7f
				];
				qcom,wf-fifo-period = <0>;
				qcom,wf-auto-res-disable;
				qcom,wf-brake-disable;
			};
			primitive_8 {
				qcom,primitive-id = <8>;
				qcom,wf-vmax-mv = <3600>;
				qcom,wf-fifo-preload;
				qcom,wf-fifo-data = [
					7f 7f
				];
				qcom,wf-fifo-period = <0>;
				qcom,wf-auto-res-disable;
				qcom,wf-brake-disable;
			};
		};
	};
};

&soc {
	clock_audio_va_1: va_core_clk {
		#clock-cells = <1>;
		qcom,codec-lpass-clk-id = <775>;
		qcom,codec-lpass-ext-clk-freq = <19200000>;
		qcom,codec-ext-clk-src = <2>;
		compatible = "qcom,audio-ref-clk";
	};
	clock_audio_va_2: va_npl_clk {
		#clock-cells = <1>;
		qcom,codec-lpass-clk-id = <776>;
		qcom,codec-lpass-ext-clk-freq = <19200000>;
		qcom,codec-ext-clk-src = <10>;
		compatible = "qcom,audio-ref-clk";
	};
	clock_audio_wsa_1: wsa_core_clk {
		#clock-cells = <1>;
		qcom,codec-lpass-clk-id = <777>;
		qcom,codec-lpass-ext-clk-freq = <19200000>;
		qcom,codec-ext-clk-src = <3>;
		compatible = "qcom,audio-ref-clk";
	};
	clock_audio_wsa_2: wsa2_core_clk {
		#clock-cells = <1>;
		qcom,codec-lpass-clk-id = <784>;
		qcom,codec-lpass-ext-clk-freq = <19200000>;
		qcom,codec-ext-clk-src = <12>;
		compatible = "qcom,audio-ref-clk";
	};
	clock_audio_rx_1: rx_core_clk {
		#clock-cells = <1>;
		qcom,codec-lpass-clk-id = <782>;
		qcom,codec-lpass-ext-clk-freq = <22579200>;
		qcom,codec-ext-clk-src = <5>;
		compatible = "qcom,audio-ref-clk";
	};
	clock_audio_rx_2: rx_npl_clk {
		#clock-cells = <1>;
		qcom,codec-lpass-clk-id = <783>;
		qcom,codec-lpass-ext-clk-freq = <22579200>;
		qcom,codec-ext-clk-src = <6>;
		compatible = "qcom,audio-ref-clk";
	};
	clock_audio_rx_tx: rx_core_tx_clk {
		#clock-cells = <1>;
		qcom,codec-lpass-clk-id = <786>;
		qcom,codec-lpass-ext-clk-freq = <19200000>;
		qcom,codec-ext-clk-src = <13>;
		compatible = "qcom,audio-ref-clk";
	};
	clock_audio_tx_1: tx_core_clk {
		#clock-cells = <1>;
		qcom,codec-lpass-clk-id = <780>;
		qcom,codec-lpass-ext-clk-freq = <19200000>;
		qcom,codec-ext-clk-src = <7>;
		compatible = "qcom,audio-ref-clk";
	};
	clock_audio_tx_2: tx_npl_clk {
		#clock-cells = <1>;
		qcom,codec-lpass-clk-id = <781>;
		qcom,codec-lpass-ext-clk-freq = <19200000>;
		qcom,codec-ext-clk-src = <8>;
		compatible = "qcom,audio-ref-clk";
	};
	clock_audio_wsa_tx: wsa_core_tx_clk {
		#clock-cells = <1>;
		qcom,codec-lpass-clk-id = <788>;
		qcom,codec-lpass-ext-clk-freq = <19200000>;
		qcom,codec-ext-clk-src = <14>;
		compatible = "qcom,audio-ref-clk";
	};
	clock_audio_wsa2_tx: wsa2_core_tx_clk {
		#clock-cells = <1>;
		qcom,codec-lpass-clk-id = <790>;
		qcom,codec-lpass-ext-clk-freq = <19200000>;
		qcom,codec-ext-clk-src = <15>;
		compatible = "qcom,audio-ref-clk";
	};
	clock_audio_rx_mclk2_2x_clk: rx_mclk2_2x_clk {
		#clock-cells = <1>;
		qcom,codec-lpass-clk-id = <792>;
		qcom,codec-lpass-ext-clk-freq = <19200000>;
		qcom,codec-ext-clk-src = <16>;
		compatible = "qcom,audio-ref-clk";
	};
	clock_audio_bt_swr_mclk_clk: bt_swr_mclk_clk {
		#clock-cells = <1>;
		qcom,codec-lpass-clk-id = <794>;
		qcom,codec-lpass-ext-clk-freq = <24576000>;
		qcom,codec-ext-clk-src = <18>;
		compatible = "qcom,audio-ref-clk";
	};
	clock_audio_bt_swr_mclk_clk_2x: bt_swr_mclk_clk_2x {
		#clock-cells = <1>;
		qcom,codec-lpass-clk-id = <795>;
		qcom,codec-lpass-ext-clk-freq = <24576000>;
		qcom,codec-ext-clk-src = <19>;
		compatible = "qcom,audio-ref-clk";
	};
	wsa881x_analog_clk: wsa_ana_clk {
		#clock-cells = <1>;
		qcom,codec-lpass-clk-id = <769>;
		qcom,codec-lpass-ext-clk-freq = <9600000>;
		qcom,codec-ext-clk-src = <20>;
		compatible = "qcom,audio-ref-clk";
	};
};

&lpass_cdc {
	qcom,lpass-cdc-version = <7>;
	qcom,num-macros = <5>;
	clocks = <&lpass_core_hw_vote 0>,
		<&lpass_audio_hw_vote 0>;
	clock-names = "lpass_core_hw_vote", "lpass_audio_hw_vote";
	#size-cells = <1>;
	#address-cells = <1>;
	compatible = "qcom,lpass-cdc";
	lpass_clk_mngr: lpass-cdc-clk-rsc-mngr {
		clocks = <&clock_audio_tx_1 0>,
			<&clock_audio_rx_1 0>,
			<&clock_audio_rx_tx 0>,
			<&clock_audio_wsa_tx 0>,
			<&clock_audio_wsa2_tx 0>,
			<&clock_audio_va_1 0>;
		clock-names = "tx_core_clk", "rx_core_clk", "rx_tx_core_clk", "wsa_tx_core_clk", "wsa2_tx_core_clk", "va_core_clk";
		qcom,wsa_mclk_mode_muxsel = <0x6bea110>;
		qcom,rx_mclk_mode_muxsel = <0x6bec0d8>;
		qcom,fs-gen-sequence = <12288 1 1 12292 3 3 12292 3>,
			<1 12416 2 2>;
		compatible = "qcom,lpass-cdc-clk-rsc-mngr";
	};
	rx_macro: rx-macro@6AC0000 {
		qcom,rx_mclk_mode_muxsel = <0x6bec0d8>;
		reg = <0x6ac0000 0>;
		clocks = <&clock_audio_rx_mclk2_2x_clk 0>;
		clock-names = "rx_mclk2_2x_clk";
		qcom,default-clk-id = <5>;
		qcom,rx-bcl-pmic-params = [
			00 03 48
		];
		qcom,rx-swr-gpios = <&rx_swr_gpios>;
		compatible = "qcom,lpass-cdc-rx-macro";
		swr1: rx_swr_master {
			qcom,swr-master-version = <33554432>;
			interrupts = <0 155 4>;
			swrm-io-base = <0x6ad0000 0>;
			qcom,swr-clock-stop-mode0 = <1>;
			qcom,swr-port-mapping = <1 14 1 1 15 2 2 18>,
				<3 3 16 1 3 17 2 4>,
				<19 1 5 20 1 5 21 2>,
				<6 22 1 7 23 3 8 24>,
				<3 9 59 1 9 60 2 10>,
				<26 3 11 27 3 12 28 3>;
			qcom,swr-num-ports = <12>;
			interrupt-names = "swr_master_irq";
			qcom,mipi-sdw-block-packing-mode = <1>;
			qcom,swr-num-dev = <1>;
			qcom,swr_master_id = <2>;
			clocks = <&lpass_core_hw_vote 0>,
				<&lpass_audio_hw_vote 0>;
			clock-names = "lpass_core_hw_vote", "lpass_audio_hw_vote";
			#size-cells = <0>;
			#address-cells = <2>;
			compatible = "qcom,swr-mstr";
			wcd939x_rx_slave: wcd939x-rx-slave {
				reg = <14 18285092>;
				compatible = "qcom,wcd939x-slave";
			};
			wcd9378_rx_slave: wcd9378-rx-slave {
				reg = <16 18285092>;
				compatible = "qcom,wcd9378-slave";
				status = "disabled";
			};
			wcd937x_rx_slave: wcd937x-rx-slave {
				reg = <10 18285092>;
				compatible = "qcom,wcd937x-slave";
				status = "disabled";
			};
			rx_swr_haptics: swr_haptics@f0170220 {
				qcom,rx_swr_ch_map = <0 1 1 0 22>;
				compatible = "qcom,pmih010x-swr-haptics";
				reg = <3 0xf0170220>;
				status = "disabled";
			};
		};
	};
	wsa_macro: wsa-macro@6B00000 {
		status = "ok";
		wsa_data_fs_ctl_reg = <0x6b6f000>;
		qcom,wsa-system-gains = <0 9 0 9>;
		qcom,wsa-rloads = <2 2>;
		qcom,wsa-bat-cfgs = <0 0>;
		reg = <0x6b00000 0>;
		#cooling-cells = <2>;
		qcom,noise-gate-mode = <2>;
		qcom,thermal-max-state = <11>;
		qcom,default-clk-id = <6>;
		qcom,wsa-bcl-pmic-params = [
			00 03 48
		];
		qcom,wsa-swr-gpios = <&wsa_swr_gpios>;
		compatible = "qcom,lpass-cdc-wsa-macro";
		swr0: wsa_swr_master {
			status = "disabled";
			qcom,swr-master-version = <33554432>;
			interrupts = <0 170 4>;
			swrm-io-base = <0x6b10000 0>;
			interrupt-names = "swr_master_irq";
			qcom,swr-port-mapping = <1 1 1 2 2 15 3 3>,
				<3 4 4 1 5 5 15 6>,
				<6 3 7 7 3 8 8 3>,
				<9 9 3 10 10 3 11 11>,
				<3 12 12 3 13 13 3>;
			qcom,swr-num-ports = <13>;
			qcom,swr-clock-stop-mode0 = <1>;
			qcom,dynamic-port-map-supported = <0>;
			qcom,mipi-sdw-block-packing-mode = <0>;
			qcom,swr-num-dev = <2>;
			qcom,swr_master_id = <1>;
			clocks = <&lpass_core_hw_vote 0>,
				<&lpass_audio_hw_vote 0>;
			clock-names = "lpass_core_hw_vote", "lpass_audio_hw_vote";
			#size-cells = <0>;
			#address-cells = <2>;
			compatible = "qcom,swr-mstr";
			wsa884x_0220: wsa884x@02170220 {
				sound-name-prefix = "SpkrLeft";
				qcom,cdc-static-supplies = "cdc-vdd-1p8";
				qcom,cdc-vdd-1p8-lpm-supported = <1>;
				qcom,cdc-vdd-1p8-current = <20000>;
				qcom,cdc-vdd-1p8-voltage = <1800000 1800000>;
				cdc-vdd-1p8-supply = <&L15B>;
				qcom,swr-wsa-port-params = <1 0 3 0 5 0 0 0>,
					<6 0 0 0 1 0 3 0>,
					<5 0 0 0 6 0 0 0>,
					<1 0 3 0 5 0 0 0>,
					<6 0 0 0 1 0 3 0>,
					<5 0 0 0 6 0 0 0>;
				qcom,wsa-macro-handle = <&wsa_macro>;
				qcom,lpass-cdc-handle = <&lpass_cdc>;
				qcom,spkr-sd-n-node = <&wsa_spkr_en02>;
				reg = <4 35062304>;
				status = "disabled";
				compatible = "qcom,wsa884x";
			};
			wsa884x_0221: wsa884x@02170221 {
				sound-name-prefix = "SpkrRight";
				qcom,cdc-static-supplies = "cdc-vdd-1p8";
				qcom,cdc-vdd-1p8-lpm-supported = <1>;
				qcom,cdc-vdd-1p8-current = <20000>;
				qcom,cdc-vdd-1p8-voltage = <1800000 1800000>;
				cdc-vdd-1p8-supply = <&L15B>;
				qcom,swr-wsa-port-params = <2 0 4 0 21 0 9 0>,
					<13 0 25 0 2 0 4 0>,
					<21 0 9 0 13 0 25 0>,
					<2 0 4 0 21 0 9 0>,
					<13 0 25 0 2 0 4 0>,
					<21 0 9 0 13 0 25 0>;
				qcom,wsa-macro-handle = <&wsa_macro>;
				qcom,lpass-cdc-handle = <&lpass_cdc>;
				qcom,spkr-sd-n-node = <&wsa_spkr_en13>;
				reg = <4 35062305>;
				status = "disabled";
				compatible = "qcom,wsa884x";
			};
		};
	};
	wsa2_macro: wsa2-macro@6AA0000 {
		status = "ok";
		qcom,wsa-system-gains = <0 9 0 9>;
		qcom,wsa-rloads = <2 2>;
		qcom,wsa-bat-cfgs = <0 0>;
		wsa_data_fs_ctl_reg = <0x6b6f000>;
		reg = <0x6aa0000 0>;
		#cooling-cells = <2>;
		qcom,noise-gate-mode = <2>;
		qcom,thermal-max-state = <11>;
		qcom,default-clk-id = <7>;
		qcom,wsa2-bcl-pmic-params = [
			00 03 48
		];
		qcom,wsa2-swr-gpios = <&wsa2_swr_gpios>;
		compatible = "qcom,lpass-cdc-wsa2-macro";
		swr3: wsa2_swr_master {
			status = "ok";
			qcom,swr-master-version = <33554432>;
			interrupts = <0 171 4>;
			swrm-io-base = <0x6ab0000 0>;
			qcom,dynamic-port-map-supported = <0>;
			qcom,swr-port-mapping = <1 1 1 2 2 15 3 3>,
				<3 4 4 1 5 5 15 6>,
				<6 3 7 7 3 8 8 1>,
				<9 9 1 10 10 3 11 11>,
				<3 12 12 3 13 13 3>;
			qcom,swr-clock-stop-mode0 = <1>;
			qcom,swr-num-ports = <13>;
			interrupt-names = "swr_master_irq";
			qcom,mipi-sdw-block-packing-mode = <0>;
			qcom,swr-num-dev = <3>;
			qcom,swr_master_id = <4>;
			clocks = <&lpass_core_hw_vote 0>,
				<&lpass_audio_hw_vote 0>;
			clock-names = "lpass_core_hw_vote", "lpass_audio_hw_vote";
			#size-cells = <0>;
			#address-cells = <2>;
			compatible = "qcom,swr-mstr";
			wsa884x_2_0220: wsa884x@02170220 {
				sound-name-prefix = "Spkr2Left";
				qcom,cdc-static-supplies = "cdc-vdd-1p8";
				qcom,cdc-vdd-1p8-lpm-supported = <1>;
				qcom,cdc-vdd-1p8-current = <20000>;
				qcom,cdc-vdd-1p8-voltage = <1800000 1800000>;
				cdc-vdd-1p8-supply = <&L15B>;
				qcom,swr-wsa-port-params = <1 0 3 0 5 0 0 0>,
					<6 0 0 0 1 0 3 0>,
					<5 0 0 0 6 0 0 0>,
					<1 0 3 0 5 0 0 0>,
					<6 0 0 0 1 0 3 0>,
					<5 0 0 0 6 0 0 0>;
				qcom,wsa-macro-handle = <&wsa2_macro>;
				qcom,lpass-cdc-handle = <&lpass_cdc>;
				qcom,spkr-sd-n-node = <&wsa_spkr_en02>;
				reg = <4 35062304>;
				compatible = "qcom,wsa884x_2";
				status = "disabled";
			};
			wsa884x_2_0221: wsa884x@02170221 {
