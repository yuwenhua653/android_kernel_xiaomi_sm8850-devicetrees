				reg = <10 18285091>;
				compatible = "qcom,wcd937x-slave";
				status = "disabled";
			};
		};
	};
	tx_macro: tx-macro@6AE0000 {
		reg = <0x6ae0000 0>;
		adapt-tuning-reg-values = <2064 76 76 2068 29 29 2072 124>,
			<124 2076 60 60 2080 103 103 2084>,
