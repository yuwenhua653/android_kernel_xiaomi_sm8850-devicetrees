&spf_core_platform {
	bt_swr_gpios: bt_swr_clk_data_pinctrl {
		#gpio-cells = <0>;
		qcom,lpi-gpios;
		pinctrl-1 = <&qca_swr_clk_sleep>,
			<&qca_swr_data_sleep>;
		pinctrl-0 = <&qca_swr_clk_active>,
			<&qca_swr_data_active>;
		pinctrl-names = "aud_active", "aud_sleep";
		compatible = "qcom,msm-cdc-pinctrl";
	};
};

&lpass_bt_swr {
	qcom,bt-swr-gpios = <&bt_swr_gpios>;
	clocks = <&clock_audio_bt_swr_mclk_clk 0>,
		<&clock_audio_bt_swr_mclk_clk_2x 0>,
		<&lpass_core_hw_vote 0>,
		<&lpass_audio_hw_vote 0>;
	clock-names = "bt_swr_mclk_clk", "bt_swr_mclk_clk_2x", "lpass_core_hw_vote", "lpass_audio_hw_vote";
	compatible = "qcom,lpass-bt-swr";
};

&swr4 {
	qcom,swr-port-wordlength = <15 15 15 15 15 15 15>;
	qcom,swr-master-version = <33554432>;
	qcom,swr-num-dev = <1>;
	qcom,swr-port-mapping = <1 101 3 2 103 3 3 105>,
		<3 5 102 3 6 104 3 7>,
		<106 3 8 107 3>;
	qcom,swr-num-ports = <7>;
	interrupt-names = "swr_master_irq";
	clocks = <&lpass_core_hw_vote 0>,
		<&lpass_audio_hw_vote 0>;
	clock-names = "lpass_core_hw_vote", "lpass_audio_hw_vote";
	qcom,swr_master_id = <5>;
	compatible = "qcom,swr-mstr";
};

&swr4 {
	qcom,swr-num-dev = <1>;
	qcom,swr-port-mapping = <1 101 3 2 103 3 3 105>,
		<3 5 102 3 6 104 3 7>,
		<106 3 8 107 3>;
	qcom,swr-num-ports = <7>;
	interrupt-names = "swr_master_irq";
	clocks = <&lpass_core_hw_vote 0>,
		<&lpass_audio_hw_vote 0>;
	clock-names = "lpass_core_hw_vote", "lpass_audio_hw_vote";
	qcom,swr_master_id = <5>;
	compatible = "qcom,swr-mstr";
};

